{
  "base": "main",
  "goal": "docs/factory/GOAL.md",
  "prompts": ".factory/prompts",
  "models": {
    "default": "claude-opus-5-5",
    "review": "gpt-6-astra",
    "review_effort": "high"
  },
  "checks": [
    {"cmd": ["git", "diff", "--check", "origin/{base}...HEAD"], "timeout": 60},
    {"cmd": ["dotnet", "test", "strim.sln"], "timeout": 1800}
  ],
  "limits": {
    "max_added_lines": 400,
    "implement_per_day": 5,
    "attempts_per_story_per_day": 2,
    "fix_rounds": 2,
    "requirements_per_day": 5,
    "research_per_day": 2,
    "docs_per_day": 1,
    "budget_usd": {"requirements": 2, "research": 2, "implement": 5, "fix": 3, "docs": 2},
    "timeout_s": {"requirements": 900, "research": 1500, "implement": 3000, "fix": 2400, "review": 1200,
                  "docs": 1800}
  },
  "policy": {
    "protected": [".factory/*", "docs/factory/*", "AGENTS.md", "CLAUDE.md", ".claude/*", ".codex/*", ".github/*",
                  ".gitignore"],
    "forbidden": ["Dockerfile", ".dockerignore", "docker-compose*.yml", "LICENSE", "fonts/*", "tools/*"],
    "dependencies": ["*.csproj", "*.sln", "global.json", "Directory.Build.*", "Directory.Packages.props",
                     "*[Nn]u[Gg]et.[Cc]onfig"],
    "forbidden_patterns": ["'unsafe-(inline|eval)'", "-----BEGIN [A-Z ]*PRIVATE KEY-----"],
    "tests": ["api.Tests/*"],
    "size_exempt": ["docs/*"]
  },
  "review_inputs": ["input:feedback"]
}
